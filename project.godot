; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="JRPG Demo"
config/description="This shows a method of creating grid-based movement with Godot
and GDScript. It also includes a simple JRPG-style dialogue and
battle system on top of it."
config/tags=PackedStringArray("2d", "demo", "gui", "official", "tilemap")
run/main_scene="res://game.tscn"
config/features=PackedStringArray("4.7")
config/icon="res://icon.svg"

[autoload]

Dialogic="*uid://ds2q0uclmolvu"
GameState="*res://game_state.gd"

[debug]

gdscript/warnings/untyped_declaration=1

[dialogic]

directories/dch_directory={
"draw": "res://dialogue/dialogic/characters/draw.dch",
"enemy": "res://dialogue/dialogic/characters/enemy.dch",
"manga": "res://dialogue/dialogic/characters/manga.dch",
"rhythm": "res://dialogue/dialogic/characters/rhythm.dch",
"write": "res://dialogue/dialogic/characters/write.dch",
"xinhuo": "res://dialogue/dialogic/characters/xinhuo.dch"
}
directories/dtl_directory={
"npc": "res://dialogue/dialogic/timelines/npc.dtl",
"object": "res://dialogue/dialogic/timelines/object.dtl",
"player_lose": "res://dialogue/dialogic/timelines/player_lose.dtl",
"player_won": "res://dialogue/dialogic/timelines/player_won.dtl",
"return_main": "res://dialogue/dialogic/timelines/return_main.dtl",
"room2_alone": "res://dialogue/dialogic/timelines/room2_alone.dtl",
"room2_key": "res://dialogue/dialogic/timelines/room2_key.dtl",
"test_branch": "res://dialogue/dialogic/timelines/test_branch.dtl",
"test_story": "res://dialogue/dialogic/timelines/test_story.dtl"
}
layout/style_directory={
"": "res://dialogue/dialogic/layout/neofire_style.tres"
}
layout/default_style="res://dialogue/dialogic/layout/neofire_style.tres"
text/letter_speed=0.025
layout/end_behaviour=2.0
glossary/default_case_sensitive=true
layout/style_list=[]
variables={}
text/initial_text_reveal_skippable=true
text/text_reveal_skip_delay=0.1
text/advance_delay=0.1
text/autoadvance_per_character_delay=0.1
text/autoadvance_ignored_characters_enabled=true
animations/join_default_length=0.5
animations/join_default_wait=true
animations/leave_default_length=0.5
animations/leave_default_wait=true
animations/cross_fade_default_length=0.5
choices/autofocus_first=false
choices/delay=0.2
choices/reveal_delay=0
choices/reveal_by_input=false
save/autosave_delay=60.0
save/encryption_on_exports_only=true
translation/enabled=false
translation/original_locale="zh_Hans"
translation/file_mode=1
translation/translation_folder=""
translation/save_mode=0
translation/add_separator=false
text/autopauses={}
audio/channel_defaults={
"": {
"audio_bus": "",
"fade_length": 0.0,
"loop": false,
"volume": 0.0
},
"music": {
"audio_bus": "",
"fade_length": 0.0,
"loop": true,
"volume": 0.0
}
}

[display]

window/size/viewport_width=1920.0
window/size/viewport_height=1080.0
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/x_agent_rpc/plugin.cfg", "res://addons/dialogic/plugin.cfg")

[filesystem]

import/blender/enabled=false

